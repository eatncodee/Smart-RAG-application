# Real-Time Full-Duplex Voice RAG Assistant
# Never commit the real values to Git.

# Gemini/Google API key. Used for Gemini chat and embeddings.
GOOGLE_API_KEY=your_google_ai_api_key_here

# Sarvam AI key for speech-to-text.
SARVAM_API_KEY=your_sarvam_api_key_here

# Cartesia key for text-to-speech.
CARTESIA_API_KEY=your_cartesia_api_key_here

# Optional settings
# CHROMA_DB_PATH=./chroma_db
# CHROMA_COLLECTION_NAME=docs
# CORS_ORIGINS=https://your-frontend.example.com
# WARMUP_ON_STARTUP=false

# Backwards-compatible names accepted by the app:
# key=your_google_ai_api_key_here
# Sarvam_key=your_sarvam_api_key_here
# Cartesia_key=your_cartesia_api_key_here
